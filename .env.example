# Telegram: токен бота от @BotFather и твой telegram id (узнать у @userinfobot)
BOT_TOKEN=your_telegram_bot_token
CHAT_ID=123456789
# Прокси для Telegram, если api.telegram.org недоступен напрямую (VPN не нужен).
# Например локальный SOCKS5 из Happ: socks5://127.0.0.1:1080
TG_PROXY=

# Группа, как в файле расписания
GROUP=2025-ТНГ-96Д

# VK: юзер-токен с доступом к messages (см. README) и peer_id беседы (2000000000 + номер чата)
VK_TOKEN=
VK_CHAT_PEER_ID=0
VK_CHECK_INTERVAL=300

# ЭлЖур: адрес школы вида https://school.eljur.ru и учётка
ELJUR_URL=
ELJUR_LOGIN=
ELJUR_PASSWORD=
